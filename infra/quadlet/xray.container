[Unit]
Description=Ethereum Xray backend and dashboard
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/ethp2p/xray:bf03ba6
Pull=missing
ContainerName=ethp2p-xray
User=1000
Group=1000
PublishPort=127.0.0.1:9100:9100
Volume=/home/ubuntu/.xray/data:/data
Volume=/run/xray:/run/xray
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
LogDriver=journald
PidsLimit=1024
Exec=--ingest=/run/xray/xray.sock --listen=0.0.0.0:9100 --data-dir=/data --static-dir=/srv/dashboard --genesis-unix=1606824023 --retention-days=30
PodmanArgs=--stop-timeout=60

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=5min
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
