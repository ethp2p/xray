{
  "name": "@xray/probe",
  "version": "0.1.0",
  "description": "Xray stream instrumentation for Node.js libp2p clients",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "generate": "cd ../.. && clients/js/node_modules/.bin/buf generate --template buf.gen.ts.yaml",
    "prepack": "npm run build",
    "format": "prettier --write src/*.ts test/*.ts *.json README.md",
    "lint": "prettier --check src/*.ts test/*.ts *.json README.md"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "peerDependencies": {
    "@libp2p/interface": "^3.4.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@libp2p/crypto": "5.1.25",
    "@libp2p/interface": "3.4.0",
    "@libp2p/peer-id": "6.0.17",
    "@libp2p/utils": "7.4.3",
    "@multiformats/multiaddr": "13.0.3",
    "@types/node": "24.10.1",
    "sinon": "22.0.0",
    "sinon-ts": "2.0.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
